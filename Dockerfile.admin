FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /app
COPY gradle gradle
COPY gradlew build.gradle.kts settings.gradle.kts gradle.properties ./
COPY jango-common/build.gradle.kts jango-common/
COPY jango-core/build.gradle.kts jango-core/
COPY jango-admin/build.gradle.kts jango-admin/
RUN chmod +x gradlew && ./gradlew dependencies --no-daemon || true
COPY jango-common jango-common
COPY jango-core jango-core
COPY jango-admin jango-admin
RUN ./gradlew :jango-admin:bootJar --no-daemon -x test

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app
USER app
COPY --from=build /app/jango-admin/build/libs/*.jar app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "app.jar"]
