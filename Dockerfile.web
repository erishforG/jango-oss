## Stage 1: Build frontend
FROM node:22-alpine AS build
ARG VITE_GOOGLE_CLIENT_ID=""
ARG VITE_ADMIN_SECRET=""
ARG VITE_FIREBASE_AUTH_DOMAIN=""
ARG VITE_API_BASE_URL=""
ARG VITE_SENTRY_DSN=""
ARG VITE_APP_ENV="sandbox"
ARG VITE_RELEASE=""
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_ADMIN_SECRET=$VITE_ADMIN_SECRET
ENV VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_APP_ENV=$VITE_APP_ENV
ENV VITE_RELEASE=$VITE_RELEASE
WORKDIR /web
COPY jango-web/package.json jango-web/package-lock.json ./
RUN npm ci
COPY jango-web/ ./
RUN npm run build

## Stage 2: Serve static assets
FROM nginx:1.27-alpine
WORKDIR /usr/share/nginx/html
COPY --from=build /web/dist ./

# SPA fallback
RUN printf 'server {\n  listen 8080;\n  server_name _;\n  root /usr/share/nginx/html;\n  index index.html;\n\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n\n  location /assets/ {\n    add_header Cache-Control "public, max-age=31536000, immutable";\n  }\n\n  location = /index.html {\n    add_header Cache-Control "no-cache, no-store, must-revalidate";\n  }\n}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
